  "rulings": [
    {
      "topic": "ドラゴン・W・ブレイカー",
      "rule": "各ブレイク前の処理は必須。最初に裏向きのシールドを作り、次のカードをそこへ重ねられる。表向きを選んでシールドがなければカードを公開・移動しない。",
      "sources": [
        "https://dm.takaratomy.co.jp/rule/qa/31639/",
        "https://dm.takaratomy.co.jp/rule/qa/41184/",
        "https://dm.takaratomy.co.jp/rule/qa/31641/"
      ]
    },
    {
      "topic": "重なったシールド",
      "rule": "シールドの数と物理カード枚数を分離。1つの束をブレイクすると全カードが手札へ移動し、表向きのカードもS・トリガーを宣言できる。トリガー・プラスやトライショットの条件はブレイクした束の数で判定。",
      "sources": [
        "https://dm.takaratomy.co.jp/coverage/dmgp07_08/",
        "https://dm.takaratomy.co.jp/img/dm_rule_20261015.pdf"
      ]
    },
    {
      "topic": "カード指定とエレメント指定",
      "rule": "サッヴァークは進化元を含むカード1枚を指定。進化の一番上を移動すると再構築し、非進化の一番上を移動すると残りは墓地へ。ゼオスのエレメント指定はバトルゾーンの構成全体を対象とする。",
      "sources": [
        "https://dm.takaratomy.co.jp/rule/qa/44094/",
        "https://dm.takaratomy.co.jp/product/dm23rp1/"
      ]
    },
    {
      "topic": "EXライフ",
      "rule": "束の一部だけを移動してもEXライフのシールド離脱能力は誘発しない。残りの束の識別を維持し、EXライフで代わりに墓地へ置く時は束全体を移動する。",
      "sources": [
        "https://dm.takaratomy.co.jp/rule/qa/39549/",
        "https://dm.takaratomy.co.jp/rule/qa/39550/"
      ]
    },
    {
      "topic": "ドラゴ大王",
      "rule": "既にいる非ドラゴンは除去しない。両者の非ドラゴンの登場を墓地に置き換え、自身も登場時バトルの味方に選べる。タマシード／クリーチャーは実際にクリーチャーとして出る場合に登場制限を適用。",
      "sources": [
        "https://dm.takaratomy.co.jp/rule/qa_old/37052/",
        "https://dm.takaratomy.co.jp/rule/qa_old/37053/",
        "https://dm.takaratomy.co.jp/rule/qa/42061/"
      ]
    },
    {
      "topic": "ギャイのマナ召喚",
      "rule": "コストの支払いが必要。マナの召喚対象自身もマナ支払いに使える。自分の各ターン、各ギャイにつきドラゴン1体まで。",
      "sources": [
        "https://dm.takaratomy.co.jp/rule/qa_old/36970/"
      ]
    },
    {
      "topic": "ドギラゴン閃のファイナル革命",
      "rule": "公開した4枚は選択と展開を終えるまで別効果から保護。多色・非進化の合計コスト6以下を先に選び、登場順と残りの山札の下の順序を選べる。ファイナル革命の使用済み状態は他のファイナル革命と共有。",
      "sources": [
        "https://dm.takaratomy.co.jp/img/dm_rule_20261015.pdf"
      ]
    }
  ]
}
