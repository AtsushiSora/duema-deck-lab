  "decisions": [
    {
      "source": "https://dm.takaratomy.co.jp/rule/regulation/",
      "implementation": "セイント・キャッスルは1枚制限。公式大会構成から3枚を差し替え、練習用であることと変更点を表示する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/48934/",
      "implementation": "極限ファイナル革命と通常のファイナル革命はゲーム中の使用履歴を共有。通常ファイナルのターンごとの使用条件は維持する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/49029/",
      "implementation": "相手のカード効果によるバトルでもバトルによる破壊は状況起因処理。離れない効果は適用されない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/45094/",
      "implementation": "最初のエレメント登場と最初の呪文は共通イベント。引かなくてもコスト以下の手札のクリーチャーを出せる。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/45467/",
      "implementation": "ザゼはシールドに加えた物理カードごとに誘発する。すでにアンタップしていてもモードを選ぶ。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/48488/",
      "implementation": "ハッスルは実行以外の方法で表向きで置いても登場時能力と展開置換を適用する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/48746/",
      "implementation": "ポッピはバトルゾーンからのスマッシュ・バーストを禁止するが、解決前に手札へ移った同じカードなら呪文面を唱えられる。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/48504/",
      "implementation": "セイントの置換ブレイクでは自身のG城置換を重ねない。手札へ戻し、1ブレイクとして数える。通常のG城ブレイクは墓地に置換し実績に数えない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/48491/",
      "implementation": "エスケープ・エバーラストの保護など、置換効果で戻すG城は手札へ。G城の墓地置換をさらに重ねない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/48489/",
      "implementation": "相手ターンのリバース・ドラゴンや5.S.D.によるブレイク置換を優先。G城の墓地置換やセイントの置換は重ねない。"
    }
  ]
}
