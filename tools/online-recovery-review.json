  "findings": [
    {
      "id": "online-field-primary-ignores-selection",
      "severity": "medium",
      "status": "confirmed-open",
      "title": "場のハイパー化対象を選んでもメインボタンが攻撃ステップへ進める",
      "location": "dist/online-ui.js:46",
      "related": [
        "dist/battle-controls.js:15",
        "dist/app.js:1037"
      ],
      "reproduction": "メインステップで冥土人形ヴァミリア・バレルとタップできる別のクリーチャーを置き、ヴァミリア・バレルを選択して下部メインボタンを押す。",
      "expected": "選択したカードの能力・操作を確認できる。",
      "actual": "合法なhyper操作は操作パネルに存在するが、own.battleがselectedCardの検索対象から外れているため下部は「攻撃へ進む」。押すとphase=attackとなり、ハイパー化の合法操作が消える。",
      "impact": "選んだカードの操作を進めるつもりで、能力を使わずに攻撃ステップへ移ってしまう。パネル内の明示的なハイパー化ボタンからは使える。",
      "recommendation": "選択中カードの判定に自分のバトルゾーンを含める。場の起動能力・ギア・タマシード等と通常の攻撃選択の両方を回帰確認する。",
      "diagnosticCases": [
        4
      ]
    },
    {
      "id": "online-room-code-draft-lost-on-recovery",
      "severity": "medium",
      "status": "confirmed-open",
      "title": "通信復旧時に入力途中のルームコードが消える",
      "location": "dist/app.js:1281",
      "related": [
        "dist/app.js:1295",
        "dist/app.js:877",
        "dist/online-ui.js:93"
      ],
      "reproduction": "ロビーで通信エラーが起きた後、ルームコードを入力し、入力欄からフォーカスを外す前に自動再接続が成功する。",
      "expected": "入力した16文字のコードを保持する。",
      "actual": "onlineCodeの保存がchangeイベントのみ。入力中はonlineCodeが空のため、復旧によるルート再描画で入力欄が空になる。16文字入力→復旧→空の値を確認。",
      "impact": "招待コードの入力・貼り直しが必要になる。",
      "recommendation": "input時にコードの下書きを保持し、同じアカウントのロビー再描画で引き継ぐ。",
      "diagnosticCases": [
        3
      ]
    },
    {
      "id": "online-permanent-errors-retry-without-backoff",
      "severity": "medium",
      "status": "confirmed-open",
      "title": "版不一致・参加権限エラーでも3秒ごとの自動通信が続く",
      "location": "dist/online.js:5",
      "related": [
        "dist/online.js:8"
      ],
      "reproduction": "友達対戦画面を開いたまま、サーバーの対応版が不一致、またはGETが参加権限エラー403を返す状態にする。",
      "expected": "更新やアカウント変更が必要なエラーは自動再試行を止める。一時的な通信障害には待機時間を増やす。",
      "actual": "どちらのエラーでも毎回finallyから次の3000msタイマーを予約。時刻を制御したローカル検証で、5回の3秒間隔を進めると最初の1回を含め6回GETし、さらに次のGETも予約された。",
      "impact": "エラーを解消できないまま通信が続き、不要なサーバー呼び出し・利用枠の消費につながる。実際のNetlify課金額や枠の消費は測定していない。",
      "recommendation": "エラーの種別を保持し、版不一致・権限等は手動操作待ちにする。再試行可能な障害は上限付きの間隔増加を使う。",
      "diagnosticCases": [
        1,
        2
      ]
    }
  ],
  "safetyChecksPassed": [
    "サーバーがマナチャージを保存した直後に応答を失っても、再接続で結果を取得し、二重にチャージしない。",
    "同一クライアントから2件の操作を同時に送ろうとしても、保存・revision・actionsの増加は1回だけ。",
    "終了したルームをクリアして再開しても終了画面へ戻らず、保存済みの対戦結果・勝者・履歴は保持される。"
  ],
