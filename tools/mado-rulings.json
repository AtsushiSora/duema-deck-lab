  "decisions": [
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/42941/",
      "implementation": "呪文の効果を処理する前に、今回使う夢幻無月の門を宣言する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/41292/",
      "implementation": "宣言したカードが手札から墓地へ移った場合は、同じ物理カードでもその宣言では召喚しない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/42943/",
      "implementation": "素材が足りない時点でも終了時に使用宣言し、解決時に条件を確認する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/40430/",
      "implementation": "新世壊の下に置かれている魔導具カードを、無月の門の素材にしない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/49535/",
      "implementation": "他のカードの下にある魔導具は素材に数えない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/41806/",
      "implementation": "素材として選んだ場の魔導具の下にあるカードは、その魔導具と一緒に重なる。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/42530/",
      "implementation": "手札からの無月の門は、墓地の素材を使ってもとこしえの超人に置換されない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/39947/",
      "implementation": "墓地からの無月の門がとこしえで置換される場合、選んだ素材は元の場所に残る。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/39117/",
      "implementation": "ギャイアによる登場の置換では、重ねた構成カードもマナへ移る。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/48909/",
      "implementation": "通常の登場置換では無月の門の構成カード全体を処理する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/39946/",
      "implementation": "ガル・ラガンザーク本体の選択保護は、その下のカードには適用しない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/40427/",
      "implementation": "非進化カードの本体だけを選んで移す場合、残った下のカードは墓地へ置く。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/40424/",
      "implementation": "呪文の処理中に出た新世壊も、唱え終わりの時点に存在すれば収納先にできる。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/42927/",
      "implementation": "唱え終わりに新世壊が存在しなければ、その下へ置けない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/40431/",
      "implementation": "収納を選んだら、そこに付随するドローを行う。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/41117/",
      "implementation": "外国のプレイヤーが唱えても、魔導具呪文の持ち主の新世壊が収納先になる。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/41118/",
      "implementation": "同じプレイヤーの呪文の行き先を変える置換が複数ある時は選択する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/49215/",
      "implementation": "相手が唱えた呪文の行き先では、ターンプレイヤーの置換を先に適用する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/42954/",
      "implementation": "新世壊による置換の中で行うドローに、ドロー自体への別の置換を重ねない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/44088/",
      "implementation": "シャコガイルはドロー自体ではなく山札切れの敗北を置換するため、置換によるドローでも勝てる。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/40433/",
      "implementation": "無月の門99の条件にはカードに書かれたコストを使う。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/31884/",
      "implementation": "同じ新世壊が離れて出直せば、別の能力として無月の門99を再使用できる。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/42929/",
      "implementation": "＄スザーク＄の破壊とランダムな手札破壊は順番に行う。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/39652/",
      "implementation": "ターン開始時はマナをアンタップするカードを選んでから次の処理へ進む。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa_old/38006/",
      "implementation": "終了時には条件未達の新世壊も誘発を待機し、解決時に下の枚数を確認する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/card/detail/?id=dmrp04m-m02",
      "implementation": "デ・スザークの無月の門は魔導具クリーチャーの登場時に宣言し、場2つと墓地2つを重ねる。タップ登場は下にある物理カードを4枚以上数える。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/31822/",
      "implementation": "ギ・ルーギリンの虚無月の門は魔導具呪文の使用時に宣言し、呪文解決後に素材を選ぶ。唱えた呪文自体も墓地にあれば使用できる。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/31821/",
      "implementation": "虚無月の門は場と墓地の合計4つでよく、墓地の4つだけでも使える。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/43868/",
      "implementation": "卍・獄・殺のS・トリガー判定はシールドを離れる前の両墓地の合計13枚以上で固定し、後続のS・バックや城による墓地増加は数えない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/42645/",
      "implementation": "スーパー・S・トリガーの追加能力は最後のシールドの使用宣言時に得る。その後別のトリガーでシールドが増えても失われない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/card/detail/?id=dmart24-006",
      "implementation": "ギャプドゥは最新の公式テキストに合わせ、次の相手ターン開始まで攻撃・ブロックを禁止する。追加ターン中も継続し、後から出た相手クリーチャーも対象となる。"
    }
  ]
}
