  "findings": [
    {
      "id": "online-stale-action-context",
      "severity": "low",
      "status": "confirmed-open",
      "title": "Queued ordinary moves are not bound to their originating room or current view",
      "locations": [
        "dist/app.js:910",
        "dist/app.js:1053"
      ],
      "rootCause": "online-move compares revision only; onlineMove checks actor and connection but does not bind the event to its original room, UID or active view. Revisions and action IDs repeat in different rooms.",
      "reproductionVariants": [
        {
          "id": "stale-move-after-leaving-view",
          "old": {
            "action": "online-move",
            "index": "0",
            "revision": "1",
            "room": "0000000000000001",
            "kind": "charge"
          },
          "before": 1,
          "after": 2,
          "currentView": "account",
          "reproduced": true
        },
        {
          "id": "stale-move-in-another-room",
          "old": {
            "action": "online-move",
            "index": "0",
            "revision": "1",
            "room": "0000000000000001",
            "kind": "charge"
          },
          "newRoom": "0000000000000002",
          "before": 1,
          "after": 2,
          "reproduced": true
        }
      ],
      "controls": [
        {
          "freshVisibleActionAccepted": true,
          "staleRevisionInSameRoomRejected": true
        }
      ],
      "impact": "A delayed event from a formerly visible mana-charge action can charge in the background after leaving the match, or in a different match when its revision and action ID match.",
      "limits": "Reproduced by explicitly delivering an old button event in the actual-app VM with real HTTP handler and encrypted isolated persistence. Not observed during ordinary manual browser use; no estimate of real-world frequency. This is a client UI race guard gap, not a server authorization bypass.",
      "nextFix": "Bind mutating action elements to UID and room context and require the online view. Validate that context before dispatching every ordinary, primary, number, mana-payment and confirmed move. Preserve same-context legal moves and add regression cases."
    }
  ],
