  "decisions": [
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/42513/",
      "implementation": "マーダンは条件付き登場・召喚登場・上に重ねた時などの登場時能力も使える。新しくクリーチャーを出したり、他の監視能力を誘発させたりしない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/48952/",
      "implementation": "借りたファイナル革命にも、同じプレイヤーのそのターンの使用済み制限を適用する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/45575/",
      "implementation": "ヨビニオン等の「このクリーチャー」のコストはマーダン自身の4を参照する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/45572/",
      "implementation": "W・メクレイドは使う2枚までと順序を先に決めて公開し、残りの見ているカードを他の移動効果から保護する。使用後に残りを好きな順序で下へ置く。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/43077/",
      "implementation": "メクレイドで見ている残りは、使用したカードのドローなどで動かさない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/43487/",
      "implementation": "ジャガイストの任意の手札破壊は2枚以上の手札がある場合にのみ開始する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/43766/",
      "implementation": "他のクリーチャーの山札からの登場を監視するジャガイストは、登場クリーチャー自身を停止するキーナリーの影響を受けない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/43862/",
      "implementation": "ジャガイストで出したクリーチャーは、プレイヤー以外への攻撃でも条件付きの終了時移動が発生する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/44212/",
      "implementation": "各ターンに一度の任意能力は、最初の機会を見送ってから後の機会で使用でき、カードの個体ごとに使用回数を保持する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/43869/",
      "implementation": "覇ロードの攻撃先制限は各ターン最初の攻撃だけ。ブロックされた場合も次の攻撃には持ち越さない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/46393/",
      "implementation": "クロックがターンを飛ばした場合、アビスラッシュの終了時移動は誘発せず、次の終了時にも持ち越さない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/43339/",
      "implementation": "複数のアビスラッシュの終了時移動は、持ち主が好きな順序で解決する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/44826/",
      "implementation": "ジャシンの墓地召喚軽減とアビスラッシュによる墓地からの使用許可を区別する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/42510/",
      "implementation": "マーダンが選ぶ相手の墓地のカードはクリーチャーに限定せず、対応済みのフィールドなども選べる。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/45057/",
      "implementation": "登場・攻撃等を同じ段落に含む能力も、登場時能力として1つ選択する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/47484/",
      "implementation": "能力の本文で召喚履歴を参照する場合はマーダン自身の当該ターンの履歴を参照する。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/45059/",
      "implementation": "借りたマクアで対象カードが墓地から移動した場合、戻っても古い墓地オブジェクトを追跡しない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/43868/",
      "implementation": "S・トリガーの資格はシールド移動前に確定する。その後S・バックで捨てて墓地が増えても資格を再判定しない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/43952/",
      "implementation": "S・バックは闇のシールドを捨てる必要がある。無料の呪文コストとは独立して扱う。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/42963/",
      "implementation": "同時に複数のジャシンが離れる場合、ターンプレイヤーから置換と捨てる手札を予約し、予約後に実際の移動を行う。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/42959/",
      "implementation": "別々の同時置換に同じ手札を重複予約したり、置換後に増える資源を先に支払いへ使ったりしない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/45550/",
      "implementation": "ジャシンの手札破壊と同時にテレスコが離れる場合、既に場を離れるテレスコはドローを誘発しない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/42930/",
      "implementation": "同時移動の置換に影響するカードを先に選択し、処理順の違いで選択可能資源を増やさない。"
    },
    {
      "source": "https://dm.takaratomy.co.jp/rule/qa/43246/",
      "implementation": "前提の破壊を試み、置換によって本体が残っても、その後の効果は続ける。"
    }
  ]
}
